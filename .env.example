# Copy to .env and fill in. The real .env is gitignored and off-limits to AI
# sessions — use this file to learn variable names.

# Postgres connection for the "database" and "backend-api" MCP servers
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=pw_training
# Your Postgres role. Leave blank to let scripts/setup_db.sh fill in your OS
# username (the default role on Homebrew/local installs).
PG_USER=
PG_PASSWORD=

# Token for the "backend-api" MCP server.
# scripts/setup_db.sh generates one and writes it here automatically.
API_TOKEN=
